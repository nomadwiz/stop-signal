{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "DeployRead", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::BUCKET/deploy/service/*" },
    {
      "Sid": "ConsoleHash",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-southeast-2:ACCOUNT:parameter/stopsignal/console-hash"
    },
    { "Sid": "AgentHeartbeat", "Effect": "Allow", "Action": "ssm:UpdateInstanceInformation", "Resource": "*" },
    {
      "Sid": "AgentChannels",
      "Effect": "Allow",
      "Action": ["ssmmessages:CreateControlChannel", "ssmmessages:CreateDataChannel", "ssmmessages:OpenControlChannel", "ssmmessages:OpenDataChannel"],
      "Resource": "*"
    }
  ]
}
